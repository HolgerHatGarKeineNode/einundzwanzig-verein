# Quarantaene: keine Paketversion juenger als 7 Tage (keyv/cacheable-Angriff 2026-08-04)
min-release-age=7
# Angriffsvektor war ein preinstall-Hook
ignore-scripts=true

# npm 12 blockiert Nicht-Registry-Quellen ab Werk (allow-git/allow-remote = none).
# Dieses Projekt hat mit @einundzwanzig/group eine echte Git-Dependency
# (git+ssh://github.com/...), die sonst mit EALLOWGIT abgelehnt wird und den
# Deploy bricht. Die Quellen sind im Lockfile mit Integrity-Hash gepinnt.
allow-git=all
allow-remote=all
