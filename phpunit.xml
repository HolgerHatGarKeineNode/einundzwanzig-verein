<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         failOnPhpunitDeprecation="true"
         failOnEmptyTestSuite="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- Testbetrag, wie vor der Extraktion: der Beitrag hing frueher am
             Umgebungsnamen (production ? 21000 : 1). Jetzt haengt er an dieser
             Einstellung, damit kein Testlauf den Produktionsbetrag annimmt und
             kein Umgebungsvergleich mehr im Code steht. -->
        <env name="MEMBERSHIP_FEE" value="1"/>
        <!-- The developer's .env carries live endpoints and a signing key. A
             value set here wins over .env, so the four lines below keep them
             out of every test process: the error tracker and Nightwatch use
             their own HTTP clients (Http::preventStrayRequests() never sees
             them), NOSTR_P signs events, NOSTR_SPACE_URL names a relay.
             tests/Feature/TestEnvironmentIsHermeticTest.php holds the line. -->
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="NOSTR_P" value=""/>
        <env name="NOSTR_SPACE_URL" value=""/>
        <env name="SENTRY_LARAVEL_DSN" value=""/>
        <env name="NOSTR_RELAY" value=""/>
        <!-- Kein Testlauf baut echte Verbindungen nach draussen auf. Leer =
             fetchProfile() verbindet gar nicht erst. -->
        <env name="NOSTR_PROFILE_RELAYS" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
