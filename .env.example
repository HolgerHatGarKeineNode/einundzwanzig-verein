APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=einundzwanzig_verein
DB_USERNAME=postgres
DB_PASSWORD=secret

DB_HOST_EINUNDZANZIG=127.0.0.1
DB_PORT_EINUNDZANZIG=5432
DB_DATABASE_EINUNDZANZIG=einundzwanzig_app
DB_USERNAME_EINUNDZANZIG=postgres
DB_PASSWORD_EINUNDZANZIG=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NIP-29-Gruppen-Relay für die privaten Chaträume je Projektunterstützung.
# Produktion: wss://group.einundzwanzig.space/
# Lokal leer lassen oder auf eine eigene zooid-Instanz zeigen — gegen den
# Prod-Relay abgesetzte Gruppen-Events sind nicht zurückholbar.
NOSTR_SPACE_URL=

# Jahresbeitrag und Waehrung des Mitgliedsbeitrags. Beides geht so, wie es hier
# steht, an BTCPay — der Betrag haengt NICHT mehr am Umgebungsnamen (unter
# APP_ENV=staging kostete die Mitgliedschaft frueher 1 Satoshi). "SATS" ist der
# BTCPay-Waehrungscode fuer Satoshis; ein anderer Wert hier aendert den
# tatsaechlich verlangten Betrag um Groessenordnungen.
MEMBERSHIP_FEE=21000
MEMBERSHIP_CURRENCY=SATS
# Ab wann eine BTCPay-Invoice ihre Waehrung selbst mitbringt. Aeltere Invoices
# tragen die Store-Voreinstellung und werden beim Einloesen als SATS gewertet.
# LEEREN ODER LOESCHEN SCHALTET DIE AUSNAHME NICHT AB, sondern faellt auf die
# strenge Pruefung zurueck (jede Invoice muss SATS melden) — das ist Absicht.
MEMBERSHIP_EXPLICIT_CURRENCY_SINCE="2026-08-06 21:24:18+02:00"

# Statuten, auf die sich ein Antrag bezieht. Ausgeliefert von
# GET /api/v1/membership/config, damit ein Client die geltende Fassung anzeigen
# kann. Mit Werten belegt und NICHT leer gelassen: eine leere Zeile liefert den
# Leerstring, und der Endpunkt verwiese dann auf eine Fassung ohne Adresse.
# Bei einer Satzungsaenderung hier Datei, Nummer und Datum der beschliessenden
# Mitgliederversammlung nachziehen — ohne Codeaenderung.
MEMBERSHIP_STATUTES_URL=https://einundzwanzig.space/files/Statuten_v1.3.pdf
MEMBERSHIP_STATUTES_VERSION=1.3
MEMBERSHIP_STATUTES_ADOPTED_AT=2024-10-20

# Erlaubte Rueckkehr-Adressen nach dem BTCPay-Checkout, kommagetrennt und
# VOLLSTAENDIG (Schema, Host, Pfad; Query nur, wenn sie dazugehoert). Nur was
# hier steht, darf ein Client bei POST /payments/{jahr}/invoice als `return_url`
# mitgeben — der Wert wird BTCPays `redirectURL` und schickt danach einen
# fremden Browser weiter, waere also frei setzbar ein offener
# Weiterleitungs-Vektor mit der Vereinsdomain davor.
# LEER LASSEN HEISST: keine Adresse erlaubt, jede mitgegebene wird mit 422
# abgewiesen. Das ist Absicht — ein stiller Rueckfall auf die Profilseite liesse
# Angriffsversuch und Konfigurationsfehler gleich aussehen. Ohne mitgegebene
# Adresse bleibt es ohnehin bei der Profilseite, genau wie bisher.
MEMBERSHIP_INVOICE_RETURN_URLS=

# BTCPay-Server. BTC_PAY_BASE_URL und BTC_PAY_STORE_ID werden von der
# Rechnungserstellung UND vom Webhook-Vergleich gelesen — beide muessen auf
# denselben Store zeigen, sonst weist der Webhook jede Zustellung mit 403 ab.
BTC_PAY_BASE_URL=https://pay.einundzwanzig.space
BTC_PAY_STORE_ID=
BTC_PAY_API_KEY=
BTC_PAY_WEBHOOK_SECRET=

# Netze der Reverse Proxys / Load Balancer, denen X-Forwarded-*-Header geglaubt
# wird (ausgewertet in config/trustedproxy.php). Kommagetrennt, CIDR erlaubt;
# "*" heisst "jedem vorgelagerten Hop glauben". LEER LASSEN, solange kein Proxy
# davor steht — nginx und PHP-FPM auf demselben Host sind keiner: dort ist
# REMOTE_ADDR bereits die echte Client-IP. Ist hier faelschlich etwas gesetzt,
# darf jeder Aufrufer seine eigene IP waehlen, und Drosselung wie
# Angriffsprotokoll zeigen ins Leere.
TRUSTED_PROXIES=

# Server-zu-Server-Schluessel der /api/v1-Clients: "name:key" je Client,
# kommagetrennt. Einen Key erzeugt `php artisan api:client-key <name>`.
# Der Name landet in Log und Kontingent, der Key nie. Leer = NIEMAND kommt
# durch (fail-closed); Aenderungen brauchen `php artisan config:cache`.
# Ein Key muss mindestens 32 Zeichen aus [A-Za-z0-9_-] haben — Komma und
# Doppelpunkt sind die Trennzeichen dieser Grammatik und in einem Key nicht
# darstellbar; ein Eintrag, der die Form verfehlt, wird verworfen statt
# stillschweigend gekuerzt.
API_CLIENT_KEYS=

# Kontingente der /api/v1-Flaeche. Die Invoice-Grenze zaehlt pro Pubkey und
# TAG, weil jeder Aufruf ein POST an BTCPay mit dem Vereins-API-Key ist.
API_RATE_LIMIT_CLIENT_PER_MINUTE=120
API_RATE_LIMIT_PUBKEY_PER_MINUTE=30
API_RATE_LIMIT_INVOICE_PER_DAY=3

# Cache-Store der NIP-98-Replay-Sperre. Leer = Standard-Store. Faellt er aus,
# antwortet die API mit 503 statt Anfragen ungeprueft durchzulassen.
# Der Store muss GETEILT und atomar sein: "database" oder "redis". "array" ist
# prozesslokal (jeder PHP-FPM-Worker haette seine eigene Replay-Liste), "file"
# hat kein atomares add().
API_REPLAY_CACHE_STORE=
